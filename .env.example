# ─── Application ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="VaultMedic"

# ─── Stellar Network ───────────────────────────────────────────────────────
NEXT_PUBLIC_STELLAR_NETWORK=testnet              # testnet | mainnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_PASSPHRASE="Test SDF Network ; September 2015"

# ─── Operator Account (server-side only — NEVER expose to client) ──────────
STELLAR_OPERATOR_SECRET_KEY=S...                  # Operator Stellar secret key
STELLAR_OPERATOR_PUBLIC_KEY=G...                  # Corresponding public key

# ─── Contract IDs (set after running scripts/deploy-contracts.ts) ─────────
NEXT_PUBLIC_RECORD_REGISTRY_CONTRACT_ID=C...      # record_registry contract address
NEXT_PUBLIC_ACCESS_CONTROL_CONTRACT_ID=C...       # access_control contract address
NEXT_PUBLIC_PROVIDER_REGISTRY_CONTRACT_ID=C...    # provider_registry contract address

# ─── Demo Data (set after running scripts/demo-records.ts) ────────────────
NEXT_PUBLIC_DEMO_PATIENT_ADDRESS=G...             # Demo patient address for landing page
NEXT_PUBLIC_DEMO_CONTRACT_ID=C...                 # Demo record_registry for explorer section

# ─── Explorer URLs ─────────────────────────────────────────────────────────
NEXT_PUBLIC_STELLAR_EXPERT_URL=https://stellar.expert/explorer/testnet
NEXT_PUBLIC_STELLAR_LABORATORY_URL=https://laboratory.stellar.org

# ─── IPFS ──────────────────────────────────────────────────────────────────
WEB3_STORAGE_TOKEN=your_web3_storage_api_token    # Or nft.storage token

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://...

# ─── Auth ──────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your_32_char_secret_here
BETTER_AUTH_URL=http://localhost:3000
